# Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PUBLIC_URL=http://localhost:5000
SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0

# Database (the database itself must already exist)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=yfnc_app
DB_PASSWORD=
DB_NAME=senior_design_project

# Authentication - use a cryptographically random secret of at least 32 characters
JWT_SECRET=

# Email / SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_CONNECTION_TIMEOUT_MS=15000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=30000

# AI provider: local, gemini, or openai
AI_PROVIDER=local
AI_PROVIDER_TIMEOUT_MS=45000
AI_MODEL=

# Gemini (required only when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI (required only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# File storage. For production, point this at a persistent mounted volume.
# Relative paths are resolved from the Backend directory.
UPLOAD_DIR=uploads
